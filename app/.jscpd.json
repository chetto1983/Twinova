{
  "path": ["src", "e2e"],
  "format": ["typescript", "javascript", "markup"],
  "formatsExts": {
    "typescript": ["ts"],
    "javascript": ["js", "mjs"],
    "markup": ["svelte"]
  },
  "minTokens": 100,
  "threshold": 0,
  "reporters": ["console"],
  "ignore": ["**/*.test.ts", "**/dist/**", "**/node_modules/**", "src/paraglide/**"]
}
