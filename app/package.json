{
  "name": "twinova",
  "private": true,
  "version": "0.1.0",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "check": "npm run -s i18n && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "npm run -s i18n && vitest run",
    "coverage": "npm run -s i18n && vitest run --coverage",
    "tauri": "tauri",
    "lint": "oxlint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deadcode": "npm run -s i18n && knip",
    "dup": "jscpd",
    "mutation": "npm run -s i18n && stryker run",
    "e2e": "node e2e/run.mjs && node e2e/project.mjs && node e2e/line.mjs && node e2e/curve.mjs && node e2e/sort.mjs && node e2e/code_sort.mjs",
    "soak": "node e2e/soak.mjs",
    "check:i18n": "inlang check --project ./project.inlang",
    "brand:check": "node ../scripts/verify_brand_assets.mjs",
    "hooks": "lefthook install"
  },
  "devDependencies": {
    "@inlang/cli": "^3.6.0",
    "@inlang/paraglide-js": "^3.2.1",
    "@inlang/plugin-m-function-matcher": "^2.4.3",
    "@inlang/plugin-message-format": "^4.6.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@tsconfig/svelte": "^5.0.8",
    "@types/three": "^0.187.0",
    "@vitest/coverage-v8": "^5.1.0",
    "happy-dom": "^21.0.4",
    "jscpd": "^4.3.0",
    "knip": "^6.44.2",
    "lefthook": "^2.2.2",
    "oxlint": "^1.92.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "webdriverio": "^10.2.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "three": "^0.187.0"
  }
}
