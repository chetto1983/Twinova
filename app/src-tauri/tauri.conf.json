{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Twinova",
  "version": "0.1.0",
  "identifier": "io.github.chetto1983.twinova",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Twinova",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "chetto1983",
    "homepage": "https://github.com/chetto1983/Twinova",
    "category": "Education",
    "shortDescription": "3D factory simulator driven by IEC 61131-3",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
