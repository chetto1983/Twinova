{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "mutate": [
    "src/lib/snapshot.ts",
    "src/lib/project.ts",
    "src/lib/sources.ts",
    "src/lib/meshes.ts",
    "src/lib/families.ts",
    "src/lib/openings.ts",
    "src/lib/materials.ts",
    "src/lib/inspector.ts",
    "src/lib/picking.ts",
    "src/lib/shortcuts.ts",
    "src/lib/snapping.ts",
    "src/lib/analysis.ts"
  ],
  "reporters": ["clear-text", "progress", "json"],
  "thresholds": {
    "high": 90,
    "low": 70,
    "break": 70
  },
  "tempDirName": ".stryker-tmp",
  "ignorePatterns": [
    "src-tauri/*",
    "!src-tauri/project",
    "src-tauri/project/*",
    "!src-tauri/project/tests",
    "src-tauri/project/tests/*",
    "!src-tauri/project/tests/fixtures",
    "dist",
    "coverage",
    "reports"
  ],
  "coverageAnalysis": "perTest",
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "cleanTempDir": true,
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental.json"
}
