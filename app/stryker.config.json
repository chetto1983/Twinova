{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "mutate": ["src/lib/snapshot.ts", "src/lib/project.ts"],
  "reporters": ["clear-text", "progress", "json"],
  "thresholds": {
    "high": 90,
    "low": 70,
    "break": 70
  },
  "tempDirName": ".stryker-tmp",
  "ignorePatterns": [
    "src-tauri/*",
    "!src-tauri/project",
    "src-tauri/project/*",
    "!src-tauri/project/tests",
    "src-tauri/project/tests/*",
    "!src-tauri/project/tests/fixtures",
    "dist",
    "coverage",
    "reports"
  ],
  "coverageAnalysis": "perTest",
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "cleanTempDir": true,
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental.json"
}
